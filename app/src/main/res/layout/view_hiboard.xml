<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/couiColorBackgroundWithCard">

    <LinearLayout
        android:id="@+id/boardRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/boardHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/couiColorBackgroundWithCard"
            android:elevation="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:outlineProvider="none"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:translationZ="16dp">

            <com.coui.appcompat.searchview.COUISearchBar
                android:id="@+id/searchBar"
                style="@style/Widget.COUI.COUISearchBar"
                android:layout_width="0dp"
                android:layout_height="@dimen/coui_search_bar_height"
                android:layout_weight="1"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                app:couiHideFunctionalButton="true"
                app:couiSearchIcon="@drawable/ic_search_chrome"
                app:inputTextColor="@color/hiboard_chrome"
                app:normalHintColor="@color/hiboard_chrome_hint"
                app:searchHint="@string/header_search_hint" />

            <com.coui.appcompat.button.COUIButton
                android:id="@+id/editButton"
                style="@style/Widget.COUI.Button.Small.ButtonNew.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/edit_done"
                android:visibility="gone" />

            <com.coui.appcompat.button.COUIButton
                android:id="@+id/addButton"
                style="@style/Widget.COUI.Button.Small.ButtonNew.Secondary"
                android:layout_width="@dimen/coui_search_bar_normal_background_height"
                android:layout_height="@dimen/coui_search_bar_normal_background_height"
                android:layout_marginStart="8dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:includeFontPadding="false"
                android:gravity="center"
                android:contentDescription="@string/add_widget"
                android:text="@string/add_widget_symbol"
                android:textColor="@color/hiboard_chrome"
                android:textSize="20sp"
                app:drawableColor="@color/hiboard_chrome_fill"
                app:drawableRadius="-1dp" />
        </LinearLayout>

        <com.coui.appcompat.scrollview.COUIScrollView
            android:id="@+id/boardScroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="?attr/couiColorBackgroundWithCard"
            android:clipChildren="true"
            android:clipToOutline="true"
            android:clipToPadding="true"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="4dp"
                android:paddingBottom="24dp">

                <com.coui.appcompat.cardview.COUICardView
                    android:id="@+id/emptyPinned"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    app:cardBackgroundColor="?attr/couiColorCardBackground"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:contentPadding="20dp"
                    app:couiCardRoundCornerRadius="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/empty_pinned"
                            android:textColor="?attr/couiColorLabelPrimary" />

                        <com.coui.appcompat.button.COUIButton
                            android:id="@+id/emptyAddButton"
                            style="@style/Widget.COUI.Button.Small.ButtonNew.Secondary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="@string/add_cards" />
                    </LinearLayout>
                </com.coui.appcompat.cardview.COUICardView>

                <TextView
                    android:id="@+id/recentAppsHeader"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginBottom="8dp"
                    android:includeFontPadding="false"
                    android:text="@string/recent_apps_label"
                    android:textColor="@color/hiboard_chrome"
                    android:textSize="15sp" />

                <gd.app.hiboard.ui.grid.PackedCardLayout
                    android:id="@+id/subscribedGrid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </com.coui.appcompat.scrollview.COUIScrollView>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/storeRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_store_sheet"
        android:clickable="true"
        android:clipToOutline="true"
        android:focusable="true"
        android:outlineProvider="background"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/storeListPane"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/storeHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:paddingStart="4dp"
                android:paddingEnd="8dp">

                <TextView
                    android:id="@+id/storeClose"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:background="?android:attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="@string/store_close"
                    android:textColor="@color/hiboard_store_close"
                    android:textSize="17sp" />

                <TextView
                    android:id="@+id/storeTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="@string/catalog_title"
                    android:textColor="@color/hiboard_store_title"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/storeSearch"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="end|center_vertical"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/store_search_hint"
                    android:padding="11dp"
                    android:src="@drawable/ic_search_dark" />

                <com.coui.appcompat.searchview.COUISearchBar
                    android:id="@+id/storeSearchBar"
                    style="@style/Widget.COUI.COUISearchBar"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/coui_search_bar_height"
                    android:layout_gravity="center_vertical"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="4dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="4dp"
                    android:visibility="gone"
                    app:searchHint="@string/store_search_hint" />
            </FrameLayout>

            <LinearLayout
                android:id="@+id/storeChips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="4dp"
                android:paddingEnd="16dp"
                android:paddingBottom="8dp" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <androidx.viewpager2.widget.ViewPager2
                    android:id="@+id/storePager"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <FrameLayout
                    android:id="@+id/storeSearchPane"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/hiboard_store_bg"
                    android:visibility="gone">

                    <com.coui.appcompat.scrollview.COUIScrollView
                        android:id="@+id/storeScroll"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:fillViewport="true">

                        <LinearLayout
                            android:id="@+id/storeList"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingEnd="36dp"
                            android:paddingBottom="24dp" />
                    </com.coui.appcompat.scrollview.COUIScrollView>

                    <LinearLayout
                        android:id="@+id/storeIndex"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end|center_vertical"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:paddingEnd="16dp"
                        android:paddingStart="8dp" />
                </FrameLayout>
            </FrameLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/storeDetailPane"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/hiboard_store_bg"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="4dp"
                android:paddingEnd="16dp">

                <ImageView
                    android:id="@+id/storeDetailBack"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/store_back"
                    android:padding="11dp"
                    android:src="@drawable/ic_nav_back" />

                <TextView
                    android:id="@+id/storeDetailTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="1"
                    android:textColor="@color/hiboard_store_title"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="44dp"
                    android:layout_height="44dp" />
            </LinearLayout>

            <com.coui.appcompat.scrollview.COUIScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:fillViewport="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="24dp">

                    <FrameLayout
                        android:id="@+id/storeDetailPreview"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clipChildren="false" />

                    <TextView
                        android:id="@+id/storeDetailSize"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:textColor="#FF8E8E93"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/storeDetailDesc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="@color/hiboard_store_title"
                        android:textSize="15sp" />

                    <com.coui.appcompat.button.COUIButton
                        android:id="@+id/storeDetailAdd"
                        style="@style/Widget.COUI.Button.Small.ButtonNew"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:text="@string/subscribe" />
                </LinearLayout>
            </com.coui.appcompat.scrollview.COUIScrollView>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
