<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/couiColorBackgroundWithCard"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:id="@+id/boardRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/boardHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/couiColorBackgroundWithCard"
            android:elevation="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:outlineProvider="none"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:translationZ="16dp">

            <com.coui.appcompat.searchview.COUISearchBar
                android:id="@+id/searchBar"
                style="@style/Widget.COUI.COUISearchBar"
                android:layout_width="0dp"
                android:layout_height="@dimen/coui_search_bar_height"
                android:layout_weight="1"
                app:couiHideFunctionalButton="true"
                app:searchHint="@string/header_search_hint" />

            <com.coui.appcompat.button.COUIButton
                android:id="@+id/editButton"
                style="@style/Widget.COUI.Button.Small.ButtonNew.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/edit" />

            <com.coui.appcompat.button.COUIButton
                android:id="@+id/addButton"
                style="@style/Widget.COUI.Button.Small.ButtonNew.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/add_cards"
                android:visibility="gone" />
        </LinearLayout>

        <com.coui.appcompat.scrollview.COUIScrollView
            android:id="@+id/boardScroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="?attr/couiColorBackgroundWithCard"
            android:clipChildren="true"
            android:clipToOutline="true"
            android:clipToPadding="true"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="4dp"
                    android:paddingBottom="10dp"
                    android:text="@string/subscribe_section"
                    android:textColor="?attr/couiColorLabelSecondary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <com.coui.appcompat.cardview.COUICardView
                    android:id="@+id/emptyPinned"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    app:cardBackgroundColor="?attr/couiColorCardBackground"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:contentPadding="20dp"
                    app:couiCardRoundCornerRadius="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/empty_pinned"
                            android:textColor="?attr/couiColorLabelPrimary" />

                        <com.coui.appcompat.button.COUIButton
                            android:id="@+id/emptyAddButton"
                            style="@style/Widget.COUI.Button.Small.ButtonNew.Secondary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="@string/add_cards" />
                    </LinearLayout>
                </com.coui.appcompat.cardview.COUICardView>

                <gd.app.hiboard.ui.grid.PackedCardLayout
                    android:id="@+id/subscribedGrid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:paddingStart="4dp"
                    android:paddingBottom="10dp"
                    android:text="@string/recommend_section"
                    android:textColor="?attr/couiColorLabelSecondary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <gd.app.hiboard.ui.grid.PackedCardLayout
                    android:id="@+id/recommendedGrid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </com.coui.appcompat.scrollview.COUIScrollView>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/storeRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/couiColorBackgroundWithCard"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="8dp">

            <com.coui.appcompat.button.COUIButton
                android:id="@+id/storeClose"
                style="@style/Widget.COUI.Button.Small.ButtonNew.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/store_close" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/catalog_title"
                android:textColor="?attr/couiColorLabelPrimary"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <com.coui.appcompat.scrollview.COUIScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:id="@+id/storeList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp" />
        </com.coui.appcompat.scrollview.COUIScrollView>
    </LinearLayout>
</FrameLayout>
