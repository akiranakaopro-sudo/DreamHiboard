<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <permission
        android:name="gd.app.hiboard.permission.OVERLAY_CLIENT"
        android:protectionLevel="signature|privileged" />

    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.FLASHLIGHT" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="32"
        tools:ignore="ScopedStorage" />
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <uses-permission android:name="gd.app.soundrecorder.permission.CONTROL_RECORDING" />

    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera.flash"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.microphone"
        android:required="false" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.DIAL" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="vnd.android.cursor.dir/contact" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.APP_CONTACTS" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.APP_MESSAGING" />
        </intent>
        <intent>
            <action android:name="android.media.action.STILL_IMAGE_CAMERA" />
        </intent>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
        <intent>
            <action android:name="android.settings.SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.intent.action.CREATE_NOTE" />
        </intent>
        <intent>
            <action android:name="action.nearme.note.textnote" />
        </intent>
        <intent>
            <action android:name="com.android.intent.action.NEW_EDIT_NOTE" />
        </intent>
        <intent>
            <action android:name="gd.app.note.VIEW_NOTE" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="notes" />
        </intent>
        <package android:name="com.android.settings" />
        <package android:name="gd.app.note" />
        <package android:name="gd.app.calendar" />
        <package android:name="gd.app.quicksearch" />
        <package android:name="gd.app.soundrecorder" />
        <package android:name="gd.app.systemmanager" />
        <package android:name="gd.app.phonemanager" />
        <package android:name="com.coloros.phonemanager" />
        <package android:name="com.oplus.phonemanager" />
        <package android:name="com.oplus.safecenter" />
        <package android:name="com.coloros.safecenter" />
        <intent>
            <action android:name="oplus.intent.action.CLEAR_MAIN_ACTIVITY" />
        </intent>
        <intent>
            <action android:name="oplus.intent.action.PHONE_MANAGER_MAIN_ACTIVITY" />
        </intent>
        <intent>
            <action android:name="oppo.intent.action.SAFE_CENTER_MAIN" />
        </intent>
        <intent>
            <action android:name="gd.app.soundrecorder.action.START" />
        </intent>
        <intent>
            <action android:name="gd.app.soundrecorder.action.START_RECORDING" />
        </intent>
    </queries>

    <application
        android:name=".HiboardApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/ic_launcher_foreground"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_launcher_foreground"
        android:supportsRtl="true"
        android:forceDarkAllowed="false"
        android:requestLegacyExternalStorage="true"
        android:theme="@style/Theme.Hiboard">

        <!-- Standalone host. ColorOS injects a View into the launcher instead;
             HiboardViewController is the equivalent embed contract. -->
        <activity
            android:name=".HiboardActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Hiboard">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="hiboard" />
            </intent-filter>
        </activity>

        <activity
            android:name=".deeplink.DeeplinkActivity"
            android:exported="true"
            android:theme="@style/Theme.Hiboard.Translucent">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="assistantscreen" />
            </intent-filter>
        </activity>

        <!-- OPPO-style WindowServer: launcher binds this for the -1 Quick Glance page.
             Run in default process (not :watch) so attach shares a healthy app process;
             isolate later once window attach is stable. -->
        <service
            android:name=".overlay.HiboardOverlayService"
            android:exported="true"
            android:permission="gd.app.hiboard.permission.OVERLAY_CLIENT">
            <intent-filter>
                <action android:name="gd.app.hiboard.intent.action.WINDOW_OVERLAY" />
            </intent-filter>
            <meta-data
                android:name="gd.app.hiboard.overlay.api_version"
                android:value="3" />
        </service>

        <receiver
            android:name=".overlay.OverlayDebugReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="gd.app.hiboard.action.DEBUG_OPEN_OVERLAY" />
                <action android:name="gd.app.hiboard.action.DEBUG_CLOSE_OVERLAY" />
            </intent-filter>
        </receiver>

        <provider
            android:name=".engine.RecorderCleanupProvider"
            android:authorities="gd.app.hiboard.recordings"
            android:exported="true"
            android:permission="gd.app.soundrecorder.permission.CONTROL_RECORDING" />

        <provider
            android:name=".engine.WeatherProvider"
            android:authorities="gd.app.hiboard.weather"
            android:exported="true" />
    </application>
</manifest>
